{
  "name": "stackstreak-sdk",
  "version": "0.2.0",
  "description": "JavaScript SDK for the StackStreak family of on-chain games on Stacks (Bitcoin L2): Daily Streak, Tic-Tac-Toe, Coin Flip, RPS, Higher-or-Lower, Connect Four.",
  "type": "module",
  "main": "src/index.js",
  "module": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "bin": {
    "stackstreak": "bin/cli.mjs"
  },
  "files": [
    "src",
    "bin",
    "README.md"
  ],
  "keywords": [
    "stacks",
    "bitcoin",
    "clarity",
    "web3",
    "game",
    "sdk",
    "stackstreak"
  ],
  "author": "spagero763",
  "license": "MIT",
  "homepage": "https://github.com/Spagero763/stackstreak",
  "repository": {
    "type": "git",
    "url": "https://github.com/Spagero763/stackstreak.git"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@stacks/network": "^7.3.1",
    "@stacks/transactions": "^7.4.0"
  }
}
