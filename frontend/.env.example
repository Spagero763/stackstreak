# StackStreak frontend — environment overrides
#
# These are Vite env vars. Copy this file to `.env.local` to override the
# defaults baked into src/config.js. Every var is OPTIONAL — leave a line out
# to keep the default. None of these are secrets; the contract address is a
# public on-chain identifier.

# Network the UI talks to ("mainnet" or "testnet"). Defaults to mainnet.
VITE_NETWORK=mainnet

# Deployer address that owns every game contract. Defaults to the production
# deployment. Override when pointing the UI at your own testnet/mainnet deploy.
VITE_CONTRACT_ADDRESS=SP3JKFGFTQZSDYDRA4JSV0HST1D610WMR1G7K367T

# Contract names — override only if you publish under different names.
VITE_CONTRACT_NAME=stackstreak
VITE_TTT_CONTRACT_NAME=tictactoe
#
# The four newer games (coinflip, rps, hilo, connectfour) hard-code their
# contract names in src/config.js. Edit that file if you need to change them.
